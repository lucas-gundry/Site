// Cloudflare Worker "lucasgundry": static assets only, no Worker code.
// Previews: scripts/deploy-preview.sh (wrangler versions upload, alias
// "preview"). Production (wrangler versions deploy) only with Lucas's OK.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lucasgundry",
  "account_id": "04b30eae78aaef6284ad91f88365f625",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
